# Copy to `.env` and fill in. `.env` is gitignored — never commit real keys.

# Claude API key for the LLM chess agent (https://platform.claude.com).
# Leave empty to use the local minimax agent.
ANTHROPIC_API_KEY=

# Agent backend: auto (LLM when a key is set, else minimax) | minimax | llm
AGENT_BACKEND=auto

# Claude model used by the LLM agent.
LLM_MODEL=claude-opus-5

# Who the human plays in a new game: random | white | black
DEFAULT_USER_COLOR=random

# Database (swap for PostgreSQL in production).
DATABASE_URL=sqlite:///./chess_data.db
