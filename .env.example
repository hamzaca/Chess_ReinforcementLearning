# Copy to `.env` and fill in. `.env` is gitignored — never commit real keys.

# API key for the LLM chess agent (https://platform.claude.com), also sent
# as the bearer token to LLM_BASE_URL. Leave empty to use the minimax agent.
ANTHROPIC_API_KEY=here

# Agent backend: auto (LLM when a key or base URL is set, else minimax) | minimax | llm
AGENT_BACKEND=auto

# OpenAI-compatible endpoint the agent talks to (include the /v1 suffix).
# Default: Anthropic's OpenAI-compatible endpoint. Point it at a local
# proxy/server  to run against local models.
LLM_BASE_URL=https://api.anthropic.com/v1/

# Model tag as registered on the server above.
LLM_MODEL=claude-opus-5

# LLM robustness: total move attempts (1 initial + retries with error
# feedback) before falling back to minimax, and per-request timeout (s).
MAX_LLM_ATTEMPTS=3
REQUEST_TIMEOUT_S=30

# Who the human plays in a new game: random | white | black
DEFAULT_USER_COLOR=random

# Database (swap for PostgreSQL in production).
DATABASE_URL=sqlite:///./chess_data.db
